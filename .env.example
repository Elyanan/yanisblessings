# Copy to .env.local and fill in your values

# Site URL (used for policy page canonical URLs and structured data)
NEXT_PUBLIC_SITE_URL=https://yanisblessings.com

# EmailJS — https://www.emailjs.com/docs/
# Create 3 templates (order, custom order, contact) with variables: {{subject}}, {{message}}, {{customer_name}}, etc.
EMAILJS_SERVICE_ID=service_jlzwjhx
EMAILJS_PUBLIC_KEY=YsLIWpsDLM7HI9PXc
EMAILJS_PRIVATE_KEY=CI8CUftpbj8tkTYT4iw_S
EMAILJS_TEMPLATE_ORDER=template_tqynuwj
EMAILJS_TEMPLATE_CONTACT=template_m8eqqox
OWNER_EMAIL=prowebsitecrafters@gmail.com

# NextAuth — ADMIN_USERNAME/PASSWORD are credentials YOU choose (not generated)
# AUTH_SECRET only — on Windows run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Sanity CMS — create project at sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=