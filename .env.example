# Copy to .env.local and fill in your values

# Site URL (used for policy page canonical URLs and structured data)
NEXT_PUBLIC_SITE_URL=https://yanisblessings.com

# Resend — https://resend.com/docs
# Production: verify yanisblessings.com in Resend, then use noreply@yanisblessings.com
# Local testing (before domain verified): set RESEND_SANDBOX=true (sends from onboarding@resend.dev)
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=Yani's Blessings <noreply@yanisblessings.com>
RESEND_SANDBOX=false
ORDERS_EMAIL=orders@yanisblessings.com
CONTACT_EMAIL=contact@yanisblessings.com
OWNER_EMAIL=contact@yanisblessings.com

# NextAuth — ADMIN_USERNAME/PASSWORD are credentials YOU choose (not generated)
# AUTH_SECRET only — on Windows run:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AUTH_URL must match your production domain (e.g. https://yanisblessings.com)
AUTH_SECRET=
AUTH_URL=https://yanisblessings.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Sanity CMS — create project at sanity.io
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=